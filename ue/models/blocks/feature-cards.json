{
  "definitions": [
    {
      "title": "Feature Cards",
      "id": "feature-cards",
      "model": "feature-cards",
      "filter": "feature-cards",
      "plugins": {
        "da": {
          "name": "feature-cards",
          "rows": 1,
          "columns": 1
        }
      }
    },
    {
      "title": "Feature Card Item",
      "id": "feature-cards-item",
      "model": "feature-cards-item",
      "plugins": {
        "da": {
          "name": "feature-cards-item",
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>picture>img[src]" },
            { "name": "imageAlt", "selector": "div:nth-child(1)>picture>img[alt]" },
            { "name": "text", "selector": "div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "feature-cards",
      "fields": []
    },
    {
      "id": "feature-cards-item",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Feature Icon",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Alt Text",
          "value": ""
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "text",
          "label": "Text",
          "description": "Feature title and description"
        }
      ]
    }
  ],
  "filters": [
    { "id": "feature-cards", "components": ["feature-cards-item"] }
  ]
}
